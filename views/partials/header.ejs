<div id="tools">
  <% if (locals.loggedin) { %>
    <a href="/account/" title="Manage your account">Welcome <%= locals.accountData.account_firstname %></a>
    <span> | </span> 
    <a href="/account/logout" title="Log out">Logout</a>
  <% } else { %>
    <a href="/account/login" title="Click to log in">My Account</a>
  <% } %>
</div>