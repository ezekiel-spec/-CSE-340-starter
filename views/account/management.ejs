<%- include('../partials/head') %>
<%- include('../partials/header') %>
<%- include('../partials/navigation') %>

<main class="management-wrapper">
  <h1>Account Management</h1>
  <%- messages() %>

  <div class="management-card">
    <h2>Welcome, <%= locals.accountData.account_firstname %></h2>
    <p class="login-status">You are logged in.</p>
    
    <ul>
      <li><a href="/account/update/<%= locals.accountData.account_id %>">Edit Account Information</a></li>
    </ul>

    <hr>
    <h3>My Wishlist</h3>
    <% if (wishlist && wishlist.length > 0) { %>
      <ul class="wishlist-list">
        <% wishlist.forEach(item => { %>
          <li>
            <a href="/inv/detail/<%= item.inv_id %>"><%= item.inv_year %> <%= item.inv_make %> <%= item.inv_model %></a>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p>Your wishlist is currently empty.</p>
    <% } %>

    <% if (locals.accountData.account_type === 'Employee' || locals.accountData.account_type === 'Admin') { %>
      <hr>
      <h3>Inventory Management</h3>
      <p><a href="/inv/">Manage Inventory</a></p>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>